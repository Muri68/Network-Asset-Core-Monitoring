# Copy to .env and adjust. .env is never committed.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# SQLite file (relative to the project folder) — PostgreSQL arrives in a later step
SQLITE_PATH=db.sqlite3
# Sign out after this many minutes without activity
NETCORE_IDLE_TIMEOUT_MINUTES=30
